#!/bin/sh
# Copyright (C) 2023-2026 Anya Lin

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

# uci
CONFIG_NAME='netspeedtest'
NAMEDDSECTION='config'

# netspeedtest
OOKLA_SPEEDTEST='/usr/libexec/netspeedtest/speedtest'
SPEEDTEST_RESULT='/tmp/speedtest_result'

# cloudflare-speed-cli
CF_SPEEDTEST='/usr/libexec/netspeedtest/cloudflare-speed-cli'
CF_RESULT='/tmp/cloudflare_speedtest_result'
CF_RESULT_JSON='/tmp/cloudflare_speedtest_result.json'
CF_REPO_API='https://api.github.com/repos/kavehtehrani/cloudflare-speed-cli/releases'
CF_RELEASE_URL='https://github.com/kavehtehrani/cloudflare-speed-cli/releases/download'
CF_ASSET_TPL='cloudflare-speed-cli-%s-unknown-linux-musl.tar.xz'
CF_UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 	Safari/537.36'

# api
speedTestServersUrl="https://www.speedtest.net/api/js/servers"
speedTestServersAlternativeUrl="https://www.speedtest.net/speedtest-servers-static.php"
speedTestServersAndroid="https://www.speedtest.net/api/android/config.php"
speedTestServersIOS="https://www.speedtest.net/api/ios-config.php"

ookla_verify() {
	[ -x "$OOKLA_SPEEDTEST" ]
	return $?
}

# func [args...]
speedtest() {
	echo "Testing" > "$SPEEDTEST_RESULT"
	result=$($OOKLA_SPEEDTEST --accept-gdpr --accept-license --progress=no "$@" | grep 'Result URL' | awk '{print $NF}')
	[ -n "$result" ] && echo "$result" > "$SPEEDTEST_RESULT" || echo "Test failed" > "$SPEEDTEST_RESULT"
}

cloudflare_verify() {
	[ -x "$CF_SPEEDTEST" ]
	return $?
}

cloudflare_test() {
	local proxy_args=""
	if [ "$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.cf_proxy_enabled)" = "1" ]; then
		proxy_args="--proxy $(uci -q get $CONFIG_NAME.$NAMEDDSECTION.cf_proxy_protocol)://$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.cf_proxy_server)"
	fi

	rm -f "$CF_RESULT" "$CF_RESULT_JSON"
	echo "Testing" > "$CF_RESULT"
	(
		"$CF_SPEEDTEST" --text --auto-save false --export-json "$CF_RESULT_JSON" $proxy_args > "$CF_RESULT" 2>&1
		if [ -s "$CF_RESULT_JSON" ]; then
			echo "Done" > "$CF_RESULT"
		else
			echo "Test failed" > "$CF_RESULT"
		fi
	) &
}

case "$1" in
	list)
		json_init

		json_add_object "download_ookla"
		json_add_string "arch"
		json_close_object

		json_add_object "ookla_verify"
		json_close_object

		json_add_object "speedtest"
		json_close_object

		json_add_object "download_cloudflare"
		json_add_string "arch"
		json_add_string "tag"
		json_close_object

		json_add_object "cloudflare_verify"
		json_close_object

		json_add_object "cloudflare_speedtest"
		json_close_object

		json_dump
		;;
	call)
		case "$2" in
			download_ookla)
				read -t 1 -r input
				ARCH=$(echo "$input" | jsonfilter -qe '@.arch')

				if [ -z "$ARCH" ]; then
					json_init
					json_add_boolean "result" 0
					json_add_string "error" 'illegal arch'
					json_dump
					exit
				fi

				[ "$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.proxy_enabled)" = "1" ] && \
				export ALL_PROXY=$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.proxy_protocol)://$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.proxy_server)

				UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 		Safari/537.36'

				url=$( \
					curl --connect-timeout 10 --retry 3 -sSL 'https://www.speedtest.net/apps/cli' \
					--user-agent "$UA" \
					| grep "Download for Linux" \
					| sed 's|<|\n<|g' \
					| sed -n '/Download for Linux/,/<\/div>/p' \
					| sed -En "s|.*<a href=\"([^\"]+)\">${ARCH}|\1|p" \
				)
				if [ -z "$url" ]; then
					json_init
					json_add_boolean "result" 0
					json_add_string "error" 'invalid architecture'
					json_dump
					exit
				fi

				[ -n "$url" ] && curl -sSL --url "$url" --user-agent "$UA" | tar -xvz -C /tmp >/dev/null
				mkdir -p ${OOKLA_SPEEDTEST%/*} 2>/dev/null
				cp -f /tmp/speedtest $OOKLA_SPEEDTEST
				chmod 755 $OOKLA_SPEEDTEST
				if ookla_verify; then
					json_init
					json_add_boolean "result" 1
					json_dump
					exit
				else
					rm -f $OOKLA_SPEEDTEST
					json_init
					json_add_boolean "result" 0
					json_add_string "error" 'invalid executable file'
					json_dump
					exit
				fi
				;;
			ookla_verify)
				json_init
				json_add_boolean "result" $(ookla_verify && echo 1 || echo 0)
				json_dump
				;;
			speedtest)
				if pgrep -f "$OOKLA_SPEEDTEST" >/dev/null; then
					json_init
					json_add_boolean "result" 0
					json_add_string "error" 'Speedtest is underway'
					json_dump
					exit
				fi

				[ "$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.proxy_enabled)" = "1" ] && \
				export ALL_PROXY=$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.proxy_protocol)://$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.proxy_server)

				serverList="$(curl --connect-timeout 10 --retry 3 -sSL "$speedTestServersUrl")"
				if [ -z "$serverList" ]; then
					echo "No available servers" > "$SPEEDTEST_RESULT"
					json_init
					json_add_boolean "result" 0
					json_add_string "error" 'No available servers'
					json_dump
					exit
				fi

				speedtest --server-id=$(echo "$serverList" | jsonfilter -e '@[0].id') &
				json_init
				json_add_boolean "result" 1
				json_dump
				;;
			download_cloudflare)
				read -t 1 -r input
				ARCH=$(echo "$input" | jsonfilter -qe '@.arch')
				TAG=$(echo "$input" | jsonfilter -qe '@.tag')

				case "$ARCH" in
					x86_64|aarch64) ;;
					*)
						json_init
						json_add_boolean "result" 0
						json_add_string "error" 'illegal arch'
						json_dump
						exit
						;;
				esac

				if [ "$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.cf_proxy_enabled)" = "1" ]; then
					export ALL_PROXY=$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.cf_proxy_protocol)://$(uci -q get $CONFIG_NAME.$NAMEDDSECTION.cf_proxy_server)
				fi

				if [ -n "$TAG" ]; then
					TAGS="$TAG"
				else
					releases=$(curl --connect-timeout 10 --retry 3 -sSL --user-agent "$CF_UA" "$CF_REPO_API")
					if [ -z "$releases" ] || [ -n "$(echo "$releases" | jsonfilter -qe '@.message')" ]; then
						json_init
						json_add_boolean "result" 0
						json_add_string "error" 'cannot fetch release list'
						json_dump
						exit
					fi
					TAGS=$(echo "$releases" | jsonfilter -e '@[*].tag_name')
				fi

				if [ -z "$TAGS" ]; then
					json_init
					json_add_boolean "result" 0
					json_add_string "error" 'no release found'
					json_dump
					exit
				fi

				asset=$(printf "$CF_ASSET_TPL" "$ARCH")
				exdir='/tmp/.cloudflare-speed-cli-download'
				ok=0
				for tag in $TAGS; do
					rm -rf "$exdir" 2>/dev/null
					mkdir -p "$exdir"
					curl -sSL --connect-timeout 10 --retry 3 --url "$CF_RELEASE_URL/$tag/$asset" --user-agent "$CF_UA" \
						| xz -dc 2>/dev/null | tar -xf - -C "$exdir" 2>/dev/null || continue
					bin=$(find "$exdir" -type f -name 'cloudflare-speed-cli' 2>/dev/null | head -n 1)
					[ -n "$bin" ] || continue
					mkdir -p ${CF_SPEEDTEST%/*} 2>/dev/null
					cp -f "$bin" "$CF_SPEEDTEST"
					chmod 755 "$CF_SPEEDTEST"
					ok=1
					break
				done
				rm -rf "$exdir" 2>/dev/null

				if [ "$ok" = "1" ] && cloudflare_verify; then
					json_init
					json_add_boolean "result" 1
					json_dump
					exit
				else
					rm -f "$CF_SPEEDTEST"
					json_init
					json_add_boolean "result" 0
					json_add_string "error" 'download failed'
					json_dump
					exit
				fi
				;;
			cloudflare_verify)
				json_init
				json_add_boolean "result" $(cloudflare_verify && echo 1 || echo 0)
				json_dump
				;;
			cloudflare_speedtest)
				if pgrep -f "$CF_SPEEDTEST" >/dev/null; then
					json_init
					json_add_boolean "result" 0
					json_add_string "error" 'Speedtest is underway'
					json_dump
					exit
				fi

				cloudflare_test
				json_init
				json_add_boolean "result" 1
				json_dump
				;;
		esac
		;;
esac
